  "lines": [
    {
      "scene": "hook",
      "index": 0,
      "text": "33 Jahre lang hat Jensen Huang NVIDIA geführt, und am 12. November war Schluss, mit sofortiger Wirkung.",
      "start": 0,
      "end": 6.202
    },
    {
      "scene": "hook",
      "index": 1,
      "text": "Vorbörslich fiel die Aktie um mehr als 11%.",
      "start": 6.552,
      "end": 9.55
    },
    {
      "scene": "moment",
      "index": 0,
      "text": "Angefangen hat alles Ende 1992, in einem Denny's in San José.",
      "start": 10.15,
      "end": 14.773
    },
    {
      "scene": "moment",
      "index": 1,
      "text": "Dort beschließen Jensen Huang, Chris Malachowsky und Curtis Priem, eine eigene Firma zu gründen.",
      "start": 15.123,
      "end": 20.365
    },
    {
      "scene": "moment",
      "index": 2,
      "text": "Im April 1993 ist NVIDIA da, mit 40.000 Dollar auf dem Konto.",
      "start": 20.715,
      "end": 25.435
    },
    {
      "scene": "turn",
      "index": 0,
      "text": "Warum Huang jetzt geht, steht in der Mitteilung von NVIDIA nicht.",
      "start": 26.035,
      "end": 29.444
    },
    {
      "scene": "consequence",
      "index": 0,
      "text": "NVIDIA führt jetzt Colette Kress, eigentlich die Finanzchefin, nur übergangsweise.",
      "start": 30.044,
      "end": 34.366
    },
    {
      "scene": "consequence",
      "index": 1,
      "text": "Und Harvey Jones wird der erste Vorsitzende des Verwaltungsrats, den NVIDIA je hatte.",
      "start": 34.716,
      "end": 39.184
    },
    {
      "scene": "payoff",
      "index": 0,
      "text": "Und Jones sitzt dort schon seit 1993.",
      "start": 39.784,
      "end": 42.644
    },
    {
      "scene": "payoff",
      "index": 1,
      "text": "Der Gründer vom Tisch bei Denny's ist weg, aber einer aus dem allerersten Jahr ist noch da.",
      "start": 42.994,
      "end": 47.313
    },
    {
      "scene": "share",
      "index": 0,
      "text": "Am 17. November legt NVIDIA zum ersten Mal ohne Huang Zahlen vor.",
      "start": 47.913,
      "end": 51.628
    }
  ],
